# standalone.demo — independent demonstration deployment, fully isolated from dev/test/staging/prod.
# Provisioned as its own deployment: dedicated PostgreSQL database/schema/user `sdkwork_models_demo`
# and a dedicated Redis logical DB index / `models-demo` key prefix so that no cache key
# (rate-limit, session, idempotency) ever collides with another shared-redis environment.
SDKWORK_MODELS_DEPLOYMENT_PROFILE=standalone
SDKWORK_MODELS_ENVIRONMENT=demo
SDKWORK_ENV=demo
SDKWORK_MODELS_PROFILE_ID=standalone.demo

# Region deployment dimension (REGION_SPEC.md): orthogonal to deployment profile and environment.
SDKWORK_MODELS_REGION_CODE=cn
SDKWORK_DATABASE_SEED_LOCALE=zh-CN

# Dedicated demo ingress bind/ports (kept apart from development 8080) so a meaningfully distinct
# origin can be published externally for system demonstrations.
SDKWORK_MODELS_APPLICATION_PUBLIC_INGRESS_BIND=0.0.0.0:18073
SDKWORK_MODELS_APPLICATION_PUBLIC_HTTP_URL=http://models-demo.sdkwork.com:18073

VITE_SDKWORK_MODELS_DEPLOYMENT_PROFILE=standalone
VITE_SDKWORK_MODELS_APPLICATION_PUBLIC_HTTP_URL=http://models-demo.sdkwork.com:18073

# Redis isolation: provisioning must assign a dedicated logical DB index / `models-demo` prefix
# on the shared Redis so cache, rate-limit, and idempotency keys stay confined to this environment.
