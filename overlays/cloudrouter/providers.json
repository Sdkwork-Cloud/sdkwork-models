{
  "schemaVersion": "1.0.0",
  "overlayCode": "cloudrouter",
  "description": "CloudRouter access-provider overlay. This file maps vendor-owned model facts to provider and channel defaults without redefining public model metadata. Official channels route through the BirdCoder platform relay (api.birdcoder.com) so vendor-direct credentials are never required client-side; the logged-in session auth token authenticates every request.",
  "providers": [
    {
      "providerCode": "openai_direct",
      "displayName": "OpenAI direct",
      "vendorCode": "openai",
      "protocol": "openai_compatible",
      "baseUrl": "https://api.birdcoder.com/v1",
      "capabilities": [
        "chat",
        "embedding",
        "image",
        "audio",
        "video"
      ]
    },
    {
      "providerCode": "anthropic_direct",
      "displayName": "Anthropic direct",
      "vendorCode": "anthropic",
      "protocol": "anthropic_messages",
      "baseUrl": "https://api.birdcoder.com",
      "capabilities": [
        "chat"
      ]
    },
    {
      "providerCode": "google_ai_direct",
      "displayName": "Google AI direct",
      "vendorCode": "google",
      "protocol": "google_gemini",
      "baseUrl": "https://api.birdcoder.com",
      "capabilities": [
        "chat",
        "image",
        "video"
      ]
    }
  ],
  "channels": [],
  "routes": []
}
