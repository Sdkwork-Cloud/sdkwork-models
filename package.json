{
  "name": "@sdkwork/models-catalog",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.30.2",
  "scripts": {
    "dev": "pnpm --filter @sdkwork/models-pc run dev",
    "build": "node tools/build-index.mjs && pnpm --filter @sdkwork/models run build && pnpm --filter @sdkwork/models-pc run build",
    "test": "pnpm --filter @sdkwork/models run test && pnpm --filter @sdkwork/models-pc run test && pnpm run test:rust",
    "check": "node tools/build-index.mjs --check && node tools/validate-catalog.mjs && node tools/freshness-report.mjs --max-age-policy catalog-freshness-policy.json --as-of-catalog-generated-at && node tools/catalog-audit.mjs && node tools/release-catalog.mjs --check && node tools/models_openapi_export.mjs --check",
    "verify": "pnpm run check && pnpm run test",
    "clean": "node scripts/clean.mjs",
    "validate": "node tools/validate-catalog.mjs",
    "build:index": "node tools/build-index.mjs",
    "audit": "node tools/catalog-audit.mjs",
    "freshness": "node tools/freshness-report.mjs --max-age-policy catalog-freshness-policy.json",
    "evidence:stamp": "node tools/stamp-catalog-evidence.mjs --observed-at 2026-06-24T00:00:00Z --catalog-version 2026.06.24.2",
    "diff": "node tools/catalog-diff.mjs",
    "release:check": "node tools/release-catalog.mjs --check",
    "release:validate": "node tools/release-catalog.mjs --check",
    "sdk:check": "pnpm --filter @sdkwork/models run build && pnpm --filter @sdkwork/models run test",
    "openapi:materialize": "node tools/materialize-models-openapi.mjs",
    "openapi:export": "node tools/models_openapi_export.mjs",
    "sdk:generate": "node tools/models-sdk-generate.mjs",
    "sdk:build": "pnpm --filter @sdkwork/models-backend-sdk run build && pnpm --filter @sdkwork/models-app-sdk run build",
    "db:validate": "node ../sdkwork-specs/tools/check-database-framework-standard.mjs --root .",
    "db:sqlite-baseline": "node tools/materialize-models-sqlite-baseline.mjs",
    "db:plan": "cargo run --manifest-path ../sdkwork-database/Cargo.toml -p sdkwork-database-cli -- --app-root . plan",
    "db:status": "cargo run --manifest-path ../sdkwork-database/Cargo.toml -p sdkwork-database-cli -- --app-root . status",
    "route-manifest:check": "cargo test -p sdkwork-routes-models-catalog-backend-api --test route_manifest && cargo test -p sdkwork-routes-models-catalog-app-api --test route_manifest",
    "test:rust": "cargo test --workspace --offline",
    "topology:validate": "node ../sdkwork-app-topology/scripts/sdkwork-topology.mjs validate --root . --spec specs/topology.spec.json",
    "topology:plan": "node ../sdkwork-app-topology/scripts/sdkwork-topology.mjs plan --root . --spec specs/topology.spec.json",
    "gateway:package:cloud": "node ../sdkwork-app-topology/scripts/gateway-cloud-bundle.mjs bundle --root .",
    "gateway:validate:cloud": "node ../sdkwork-app-topology/scripts/gateway-cloud-bundle.mjs validate --root .",
    "db:init": "cargo run --manifest-path ../sdkwork-database/Cargo.toml -p sdkwork-database-cli -- --app-root . init",
    "db:migrate": "cargo run --manifest-path ../sdkwork-database/Cargo.toml -p sdkwork-database-cli -- --app-root . migrate",
    "db:seed": "cargo run --manifest-path ../sdkwork-database/Cargo.toml -p sdkwork-database-cli -- --app-root . seed",
    "db:drift": "cargo run --manifest-path ../sdkwork-database/Cargo.toml -p sdkwork-database-cli -- --app-root . drift",
    "db:drift:check": "cargo run --manifest-path ../sdkwork-database/Cargo.toml -p sdkwork-database-cli -- --app-root . drift-check",
    "db:bootstrap": "cargo run --manifest-path ../sdkwork-database/Cargo.toml -p sdkwork-database-cli -- --app-root . bootstrap",
    "db:materialize:contract": "node ../sdkwork-specs/tools/materialize-database-contract-from-baseline.mjs --root . --baseline database/ddl/baseline/postgres/0001_sdkwork-models_legacy_baseline.sql --module-id sdkwork-models --owner sdkwork-models-platform --prefixes ai_model_ --engines postgres,sqlite"
  },
  "dependencies": {
    "@sdkwork/utils": "workspace:*"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "@sdkwork/clawrouter-pc-commons",
        "lucide-react",
        "react",
        "react-dom",
        "react-i18next"
      ]
    }
  }
}
