{
  "converter": "OPENAI_COMPLETIONS_TO_ANTHROPIC_MESSAGES",
  "version": "0.1.0",
  "description": "OpenAI Chat Completions API → Anthropic Messages API 转换器测试用例",
  "test_cases": [
    {
      "name": "basic_request",
      "description": "基本请求转换",
      "input": {
        "protocol": "openai_completions",
        "model": "deepseek-v4-pro",
        "messages": [
          {
            "role": "user",
            "content": "Hello"
          }
        ],
        "max_tokens": 1024,
        "temperature": 0.7,
        "stream": false
      },
      "expected": {
        "protocol": "anthropic_messages",
        "model": "deepseek-v4-pro",
        "messages_count": 1,
        "messages": [
          {
            "role": "user",
            "content": "Hello"
          }
        ],
        "max_tokens": 1024,
        "temperature": 0.7,
        "stream": false
      }
    },
    {
      "name": "with_system_message",
      "description": "包含系统消息的请求",
      "input": {
        "protocol": "openai_completions",
        "model": "deepseek-v4-pro",
        "messages": [
          {
            "role": "user",
            "content": "Hello"
          }
        ],
        "system": "You are a helpful assistant.",
        "max_tokens": 1024
      },
      "expected": {
        "protocol": "anthropic_messages",
        "model": "deepseek-v4-pro",
        "messages_count": 1,
        "system": "You are a helpful assistant."
      }
    },
    {
      "name": "with_model_mapping",
      "description": "模型映射转换",
      "input": {
        "protocol": "openai_completions",
        "model": "deepseek-v4-pro",
        "messages": [
          {
            "role": "user",
            "content": "Hello"
          }
        ]
      },
      "mapping": {
        "deepseek-v4-pro": "claude-sonnet-4",
        "deepseek-v4-flash": "claude-haiku-4"
      },
      "expected": {
        "protocol": "anthropic_messages",
        "model": "claude-sonnet-4"
      }
    },
    {
      "name": "with_tools",
      "description": "包含工具调用的请求",
      "input": {
        "protocol": "openai_completions",
        "model": "deepseek-v4-pro",
        "messages": [
          {
            "role": "user",
            "content": "What is the weather?"
          }
        ],
        "tools": [
          {
            "type": "function",
            "function": {
              "name": "get_weather",
              "description": "Get weather information",
              "parameters": {
                "type": "object",
                "properties": {
                  "location": {
                    "type": "string"
                  }
                },
                "required": ["location"]
              }
            }
          }
        ]
      },
      "expected": {
        "protocol": "anthropic_messages",
        "tools_count": 1,
        "tools": [
          {
            "type": "function",
            "function": {
              "name": "get_weather",
              "description": "Get weather information"
            }
          }
        ]
      }
    },
    {
      "name": "default_max_tokens",
      "description": "默认max_tokens",
      "input": {
        "protocol": "openai_completions",
        "model": "deepseek-v4-pro",
        "messages": [
          {
            "role": "user",
            "content": "Hello"
          }
        ]
      },
      "expected": {
        "protocol": "anthropic_messages",
        "max_tokens": 4096
      }
    },
    {
      "name": "conversation_with_history",
      "description": "多轮对话历史",
      "input": {
        "protocol": "openai_completions",
        "model": "deepseek-v4-pro",
        "messages": [
          {
            "role": "user",
            "content": "Hi"
          },
          {
            "role": "assistant",
            "content": "Hello! How can I help you?"
          },
          {
            "role": "user",
            "content": "What is 1+1?"
          }
        ]
      },
      "expected": {
        "protocol": "anthropic_messages",
        "messages_count": 3,
        "messages": [
          {
            "role": "user",
            "content": "Hi"
          },
          {
            "role": "assistant",
            "content": "Hello! How can I help you?"
          },
          {
            "role": "user",
            "content": "What is 1+1?"
          }
        ]
      }
    }
  ],
  "response_test_cases": [
    {
      "name": "basic_response",
      "description": "基本响应转换",
      "input": {
        "protocol": "anthropic_messages",
        "id": "msg_123",
        "model": "claude-sonnet-4",
        "content": [
          {
            "type": "text",
            "text": "Hello! How can I help you?"
          }
        ],
        "stop_reason": "end_turn",
        "usage": {
          "prompt_tokens": 10,
          "completion_tokens": 8,
          "total_tokens": 18
        }
      },
      "expected": {
        "protocol": "openai_completions",
        "id": "msg_123",
        "model": "claude-sonnet-4",
        "content_count": 1,
        "stop_reason": "end_turn"
      }
    },
    {
      "name": "response_with_model_reverse_mapping",
      "description": "响应模型反向映射",
      "input": {
        "protocol": "anthropic_messages",
        "id": "msg_123",
        "model": "claude-sonnet-4",
        "content": [
          {
            "type": "text",
            "text": "Hello!"
          }
        ],
        "stop_reason": "end_turn",
        "usage": {
          "prompt_tokens": 10,
          "completion_tokens": 5,
          "total_tokens": 15
        }
      },
      "mapping": {
        "deepseek-v4-pro": "claude-sonnet-4"
      },
      "expected": {
        "protocol": "openai_completions",
        "model": "deepseek-v4-pro"
      }
    }
  ]
}
