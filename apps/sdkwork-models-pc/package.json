{
  "name": "@sdkwork/models-pc",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5195",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "pnpm --filter @sdkwork/models-pc-core run typecheck",
    "clean": "node -e \"import('node:fs').then(fs=>['dist','node_modules/.vite'].forEach(p=>fs.rmSync(p,{recursive:true,force:true})))\""
  },
  "dependencies": {
    "@sdkwork/models": "workspace:*",
    "@sdkwork/models-pc-catalog": "workspace:*",
    "@sdkwork/models-pc-core": "workspace:*",
    "@sdkwork/utils": "workspace:*",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "typescript": "^5.9.0",
    "vite": "^5.4.0"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  }
}
