{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sdkwork.cloud/schemas/sdkwork-models/protocol.schema.json",
  "title": "Sdkwork Protocol Standards",
  "description": "Defines the standard AI model API protocols referenced by model apiFormat fields.",
  "type": "object",
  "required": [
    "schemaVersion",
    "families",
    "protocols"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string"
    },
    "families": {
      "description": "Standard compatibility families and their allowed base URL path prefixes. Vendor apiEndpoints.pathPrefix must be a member of the family's standardPathPrefixes.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/family"
      }
    },
    "protocols": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/protocol"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "family": {
      "type": "object",
      "required": [
        "familyCode",
        "standardPathPrefixes"
      ],
      "properties": {
        "familyCode": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "description": {
          "type": "string"
        },
        "standardPathPrefixes": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(/.*|)$"
          }
        }
      },
      "additionalProperties": false
    },
    "protocol": {
      "type": "object",
      "required": [
        "protocolCode",
        "vendorOrigin",
        "displayName",
        "family",
        "docsUrl",
        "maturity"
      ],
      "properties": {
        "protocolCode": {
          "description": "Stable protocol identifier. Models reference this value in their apiFormat field.",
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "vendorOrigin": {
          "description": "Vendor or standard owner that originated this protocol.",
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "displayName": {
          "description": "Human-readable protocol name.",
          "type": "string"
        },
        "family": {
          "description": "Protocol family grouping.",
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "version": {
          "description": "Optional protocol version string.",
          "type": "string"
        },
        "docsUrl": {
          "description": "URL to the protocol documentation.",
          "type": "string",
          "format": "uri"
        },
        "maturity": {
          "description": "Protocol maturity level.",
          "type": "string",
          "enum": [
            "stable",
            "beta",
            "deprecated",
            "experimental"
          ]
        }
      },
      "additionalProperties": false
    }
  }
}
