{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sdkwork.cloud/schemas/sdkwork-models/official-model-snapshot.schema.json",
  "title": "Sdkwork Models Official Source Snapshot",
  "type": "object",
  "required": [
    "schemaVersion",
    "catalogVersion",
    "observedAt",
    "vendors"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "catalogVersion": {
      "type": "string",
      "pattern": "^\\d{4}\\.\\d{2}\\.\\d{2}\\.\\d+$"
    },
    "observedAt": {
      "type": "string",
      "format": "date-time"
    },
    "vendors": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/vendorSnapshot"
      }
    }
  },
  "$defs": {
    "vendorSnapshot": {
      "type": "object",
      "required": [
        "vendorCode",
        "regionCode",
        "observedAt",
        "officialUrls",
        "models",
        "sourceSnapshotHash"
      ],
      "properties": {
        "vendorCode": {
          "type": "string",
          "pattern": "^[a-z0-9_]+$"
        },
        "regionCode": {
          "type": "string",
          "pattern": "^[a-z0-9_]+$"
        },
        "observedAt": {
          "type": "string",
          "format": "date-time"
        },
        "officialUrls": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "format": "uri"
          }
        },
        "models": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/modelSnapshot"
          }
        },
        "sourceSnapshotHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "additionalProperties": false
    },
    "modelSnapshot": {
      "type": "object",
      "required": [
        "modelId"
      ],
      "properties": {
        "modelId": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
