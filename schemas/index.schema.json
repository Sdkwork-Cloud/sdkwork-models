{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sdkwork.cloud/schemas/sdkwork-models/index.schema.json",
  "title": "Sdkwork Models Catalog Index",
  "type": "object",
  "required": [
    "schemaVersion",
    "catalogVersion",
    "generatedAt",
    "vendorCount",
    "regionCount",
    "modelCount",
    "pricingFileCount",
    "voiceCount",
    "modelVoiceFileCount",
    "videoProfileCount",
    "modelVideoProfileFileCount",
    "vendors"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "catalogVersion": {
      "type": "string",
      "pattern": "^\\d{4}\\.\\d{2}\\.\\d{2}\\.\\d+$"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "vendorCount": {
      "type": "integer",
      "minimum": 0
    },
    "regionCount": {
      "type": "integer",
      "minimum": 0
    },
    "modelCount": {
      "type": "integer",
      "minimum": 0
    },
    "pricingFileCount": {
      "type": "integer",
      "minimum": 0
    },
    "voiceCount": {
      "type": "integer",
      "minimum": 0
    },
    "modelVoiceFileCount": {
      "type": "integer",
      "minimum": 0
    },
    "videoProfileCount": {
      "type": "integer",
      "minimum": 0
    },
    "modelVideoProfileFileCount": {
      "type": "integer",
      "minimum": 0
    },
    "vendors": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/vendorRegionIndex"
      }
    }
  },
  "$defs": {
    "vendorRegionIndex": {
      "type": "object",
      "required": [
        "vendorCode",
        "regionCode",
        "catalogKeyPrefix",
        "displayName",
        "marketScope",
        "billingCurrency",
        "billingJurisdiction",
        "path",
        "familiesPath",
        "modelsPath",
        "modelFiles",
        "pricingPath",
        "pricingFiles",
        "rankingsPath",
        "modelCount",
        "familyCount",
        "pricingFileCount",
        "voiceCount",
        "modelVoiceFileCount",
        "videoProfileCount",
        "modelVideoProfileFileCount",
        "rankingSnapshotCount",
        "sha256"
      ],
      "properties": {
        "vendorCode": {
          "type": "string",
          "pattern": "^[a-z0-9_]+$"
        },
        "regionCode": {
          "type": "string",
          "pattern": "^[a-z0-9_]+$"
        },
        "catalogKeyPrefix": {
          "type": "string",
          "pattern": "^[a-z0-9_]+/$"
        },
        "displayName": {
          "type": "string"
        },
        "marketScope": {
          "enum": [
            "china_mainland",
            "global",
            "international"
          ]
        },
        "billingCurrency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "billingJurisdiction": {
          "type": "string"
        },
        "path": {
          "type": "string",
          "pattern": "^[a-z0-9_]+/[a-z0-9_]+/vendor\\.json$"
        },
        "familiesPath": {
          "type": "string",
          "pattern": "^[a-z0-9_]+/[a-z0-9_]+/families\\.json$"
        },
        "modelsPath": {
          "type": "string",
          "pattern": "^[a-z0-9_]+/[a-z0-9_]+/models$"
        },
        "modelFiles": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9_]+/[a-z0-9_]+/models/[^\\\\]+\\.json$"
          }
        },
        "pricingPath": {
          "type": "string",
          "pattern": "^[a-z0-9_]+/[a-z0-9_]+/pricing$"
        },
        "pricingFiles": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9_]+/[a-z0-9_]+/pricing/[^\\\\]+\\.json$"
          }
        },
        "voicesPath": {
          "type": ["string", "null"],
          "pattern": "^[a-z0-9_]+/[a-z0-9_]+/voices\\.json$"
        },
        "modelVoicesPath": {
          "type": "string",
          "pattern": "^[a-z0-9_]+/[a-z0-9_]+/model-voices$"
        },
        "modelVoiceFiles": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9_]+/[a-z0-9_]+/model-voices/[^\\\\]+\\.json$"
          }
        },
        "modelVideoProfilesPath": {
          "type": "string",
          "pattern": "^[a-z0-9_]+/[a-z0-9_]+/model-video-profiles$"
        },
        "modelVideoProfileFiles": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9_]+/[a-z0-9_]+/model-video-profiles/[^\\\\]+\\.json$"
          }
        },
        "rankingsPath": {
          "type": "string",
          "pattern": "^[a-z0-9_]+/[a-z0-9_]+/rankings\\.json$"
        },
        "modelCount": {
          "type": "integer",
          "minimum": 0
        },
        "familyCount": {
          "type": "integer",
          "minimum": 0
        },
        "pricingFileCount": {
          "type": "integer",
          "minimum": 0
        },
        "voiceCount": {
          "type": "integer",
          "minimum": 0
        },
        "modelVoiceFileCount": {
          "type": "integer",
          "minimum": 0
        },
        "videoProfileCount": {
          "type": "integer",
          "minimum": 0
        },
        "modelVideoProfileFileCount": {
          "type": "integer",
          "minimum": 0
        },
        "rankingSnapshotCount": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
