{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sdkwork.cloud/schemas/sdkwork-models/pricing.schema.json",
  "title": "Sdkwork Model Pricing",
  "type": "object",
  "required": [
    "schemaVersion",
    "vendorCode",
    "regionCode",
    "catalogKey",
    "modelId",
    "currency",
    "prices"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string"
    },
    "vendorCode": {
      "type": "string"
    },
    "regionCode": {
      "type": "string"
    },
    "catalogKey": {
      "type": "string"
    },
    "modelId": {
      "type": "string"
    },
    "currency": {
      "type": "string"
    },
    "prices": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "priceId",
          "rateHash",
          "priceBookCode",
          "productCode",
          "operationCode",
          "priceSide",
          "billability",
          "chargeTiming",
          "calculationMode",
          "meterCode",
          "quantityAggregation",
          "unitSize",
          "unitPrice",
          "minimumQuantity",
          "conditions",
          "source",
          "effectiveFrom"
        ],
        "properties": {
          "priceId": {
            "type": "string"
          },
          "rateHash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "priceBookCode": {
            "type": "string",
            "minLength": 1
          },
          "productCode": {
            "type": "string",
            "minLength": 1
          },
          "operationCode": {
            "type": "string",
            "minLength": 1
          },
          "priceSide": {
            "enum": [
              "official",
              "reference",
              "upstream",
              "customer"
            ]
          },
          "billability": {
            "enum": [
              "chargeable",
              "free",
              "not_applicable",
              "unknown"
            ]
          },
          "chargeTiming": {
            "enum": [
              "request_accepted",
              "successful_result",
              "usage_reported"
            ]
          },
          "calculationMode": {
            "enum": [
              "per_unit",
              "flat",
              "graduated",
              "volume",
              "formula"
            ]
          },
          "pricingScope": {
            "enum": [
              "model",
              "provider",
              "channel",
              "plan"
            ]
          },
          "meterCode": {
            "type": "string"
          },
          "quantityAggregation": {
            "enum": [
              "sum",
              "maximum",
              "minimum",
              "last",
              "distinct_invocation"
            ]
          },
          "unitSize": {
            "$ref": "#/$defs/decimalString"
          },
          "unitPrice": {
            "$ref": "#/$defs/decimalString"
          },
          "minimumQuantity": {
            "$ref": "#/$defs/decimalString"
          },
          "quantityStep": {
            "$ref": "#/$defs/decimalString"
          },
          "currency": {
            "type": "string"
          },
          "effectiveFrom": {
            "type": "string"
          },
          "effectiveTo": {
            "type": [
              "string",
              "null"
            ]
          },
          "priority": {
            "type": "integer",
            "minimum": 0
          },
          "rateVariant": {
            "enum": [
              "standard",
              "time_window"
            ]
          },
          "schedule": {
            "oneOf": [
              {
                "$ref": "#/$defs/priceSchedule"
              },
              {
                "type": "null"
              }
            ]
          },
          "conditions": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/rateCondition"
            }
          },
          "tiers": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/rateTier"
            }
          },
          "formula": {
            "$ref": "#/$defs/priceFormula"
          },
          "source": {
            "$ref": "#/$defs/sourceEvidence"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "rateVariant": {
                  "const": "time_window"
                }
              },
              "required": [
                "rateVariant"
              ]
            },
            "then": {
              "required": [
                "schedule"
              ],
              "properties": {
                "schedule": {
                  "$ref": "#/$defs/priceSchedule"
                }
              }
            },
            "else": {
              "properties": {
                "schedule": {
                  "type": "null"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "calculationMode": {
                  "const": "flat"
                }
              },
              "required": [
                "calculationMode"
              ]
            },
            "then": {
              "properties": {
                "unitSize": {
                  "type": "string",
                  "pattern": "^1(?:\\.0+)?$"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "calculationMode": {
                  "enum": [
                    "graduated",
                    "volume"
                  ]
                }
              },
              "required": [
                "calculationMode"
              ]
            },
            "then": {
              "required": [
                "tiers"
              ],
              "properties": {
                "tiers": {
                  "minItems": 1
                },
                "formula": false
              }
            }
          },
          {
            "if": {
              "properties": {
                "calculationMode": {
                  "const": "formula"
                }
              },
              "required": [
                "calculationMode"
              ]
            },
            "then": {
              "required": [
                "formula"
              ],
              "properties": {
                "tiers": {
                  "maxItems": 0
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "calculationMode": {
                  "enum": [
                    "per_unit",
                    "flat"
                  ]
                }
              },
              "required": [
                "calculationMode"
              ]
            },
            "then": {
              "properties": {
                "tiers": {
                  "maxItems": 0
                },
                "formula": false
              }
            }
          }
        ],
        "additionalProperties": true
      }
    }
  },
  "$defs": {
    "decimalString": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
    },
    "sourceEvidence": {
      "type": "object",
      "required": [
        "sourceUrl",
        "observedAt"
      ],
      "properties": {
        "sourceUrl": {
          "type": "string"
        },
        "observedAt": {
          "type": "string"
        },
        "sourceHash": {
          "type": "string"
        }
      }
    },
    "rateCondition": {
      "type": "object",
      "required": [
        "dimensionCode",
        "operator",
        "value"
      ],
      "properties": {
        "dimensionCode": {
          "type": "string",
          "minLength": 1
        },
        "operator": {
          "enum": [
            "eq",
            "neq",
            "gt",
            "gte",
            "lt",
            "lte",
            "in",
            "not_in",
            "exists"
          ]
        },
        "value": {
          "type": [
            "string",
            "number",
            "boolean",
            "array",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "priceSchedule": {
      "type": "object",
      "required": [
        "timeZone",
        "weeklyWindows"
      ],
      "properties": {
        "timeZone": {
          "type": "string",
          "minLength": 1
        },
        "weeklyWindows": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/weeklyPriceWindow"
          }
        },
        "includeDates": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "format": "date"
          }
        },
        "excludeDates": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "format": "date"
          }
        }
      },
      "additionalProperties": false
    },
    "weeklyPriceWindow": {
      "type": "object",
      "required": [
        "windowCode",
        "daysOfWeek",
        "startTime",
        "endTime",
        "endDayOffset"
      ],
      "properties": {
        "windowCode": {
          "type": "string",
          "minLength": 1
        },
        "daysOfWeek": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 7
          }
        },
        "startTime": {
          "type": "string",
          "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]$"
        },
        "endTime": {
          "type": "string",
          "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]$"
        },
        "endDayOffset": {
          "enum": [0, 1]
        }
      },
      "additionalProperties": false
    },
    "rateTier": {
      "type": "object",
      "required": [
        "tierCode",
        "lowerBound",
        "unitSize",
        "unitPrice"
      ],
      "properties": {
        "tierCode": {
          "type": "string",
          "minLength": 1
        },
        "lowerBound": {
          "$ref": "#/$defs/decimalString"
        },
        "upperBound": {
          "oneOf": [
            {
              "$ref": "#/$defs/decimalString"
            },
            {
              "type": "null"
            }
          ]
        },
        "unitSize": {
          "$ref": "#/$defs/decimalString"
        },
        "unitPrice": {
          "$ref": "#/$defs/decimalString"
        },
        "flatAmount": {
          "$ref": "#/$defs/decimalString"
        }
      },
      "additionalProperties": false
    },
    "priceFormula": {
      "type": "object",
      "required": [
        "formulaCode",
        "formulaVersion",
        "constantUnits",
        "quantityCoefficient",
        "terms"
      ],
      "properties": {
        "formulaCode": {
          "type": "string",
          "minLength": 1
        },
        "formulaVersion": {
          "type": "string",
          "minLength": 1
        },
        "constantUnits": {
          "$ref": "#/$defs/decimalString"
        },
        "quantityCoefficient": {
          "$ref": "#/$defs/decimalString"
        },
        "minimumUnits": {
          "$ref": "#/$defs/decimalString"
        },
        "maximumUnits": {
          "$ref": "#/$defs/decimalString"
        },
        "terms": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/priceFormulaTerm"
          }
        }
      },
      "additionalProperties": false
    },
    "priceFormulaTerm": {
      "type": "object",
      "required": [
        "termCode",
        "dimensionCode",
        "coefficient"
      ],
      "properties": {
        "termCode": {
          "type": "string",
          "minLength": 1
        },
        "dimensionCode": {
          "type": "string",
          "minLength": 1
        },
        "coefficient": {
          "$ref": "#/$defs/decimalString"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
