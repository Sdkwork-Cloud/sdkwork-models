{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sdkwork.cloud/schemas/sdkwork-models/catalog.schema.json",
  "title": "Sdkwork Models Catalog Manifest",
  "type": "object",
  "required": [
    "name",
    "schemaVersion",
    "catalogVersion",
    "generatedAt",
    "modelsRoot",
    "schemasRoot"
  ],
  "properties": {
    "name": {
      "const": "sdkwork-models"
    },
    "schemaVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "catalogVersion": {
      "type": "string",
      "pattern": "^\\d{4}\\.\\d{2}\\.\\d{2}\\.\\d+$"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "defaultLocale": {
      "type": "string"
    },
    "supportedLocales": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "modelsRoot": {
      "type": "string"
    },
    "schemasRoot": {
      "type": "string"
    },
    "overlaysRoot": {
      "type": "string"
    },
    "license": {
      "type": "string"
    },
    "repository": {
      "type": "object"
    }
  },
  "additionalProperties": true
}
