{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sdkwork.cloud/schemas/sdkwork-models/vendor.schema.json",
  "title": "Sdkwork Model Vendor",
  "type": "object",
  "required": [
    "schemaVersion",
    "vendorCode",
    "regionCode",
    "displayName",
    "vendorType",
    "marketScope",
    "billingCurrency",
    "billingJurisdiction",
    "operatingRegions",
    "capabilities",
    "supportedProtocols",
    "clientApiCompatibility",
    "source"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string"
    },
    "vendorCode": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$"
    },
    "regionCode": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "displayName": {
      "type": "string"
    },
    "legalName": {
      "type": "string"
    },
    "websiteUrl": {
      "type": "string"
    },
    "docsUrl": {
      "type": "string"
    },
    "countryRegion": {
      "type": "string"
    },
    "marketScope": {
      "enum": [
        "china_mainland",
        "global",
        "international"
      ]
    },
    "billingCurrency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "billingJurisdiction": {
      "type": "string"
    },
    "operatingRegions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "vendorType": {
      "enum": [
        "commercial",
        "open_source",
        "research",
        "community"
      ]
    },
    "modelFamilies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "capabilities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/capability"
      }
    },
    "supportedProtocols": {
      "description": "The standard API protocols this vendor defines or supports. Each entry references a protocolCode defined in schemas/protocol.schema.json. Models from this vendor use these protocols as their apiFormat value.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      }
    },
    "clientApiCompatibility": {
      "description": "Vendor-level compatibility declarations for client APIs with non-generic behavior. Region-specific base URLs, deployment properties, and prices stay outside model identity and are modeled by regional endpoint and pricing resources.",
      "type": "object",
      "required": [
        "codex",
        "claude_code",
        "gemini_cli"
      ],
      "properties": {
        "codex": {
          "$ref": "#/$defs/clientApiCompatibilityEntry"
        },
        "claude_code": {
          "$ref": "#/$defs/clientApiCompatibilityEntry"
        },
        "gemini_cli": {
          "$ref": "#/$defs/clientApiCompatibilityEntry"
        }
      },
      "additionalProperties": {
        "$ref": "#/$defs/clientApiCompatibilityEntry"
      }
    },
    "openSource": {
      "type": "boolean"
    },
    "sortOrder": {
      "type": "integer"
    },
    "source": {
      "$ref": "#/$defs/sourceEvidence"
    }
  },
  "$defs": {
    "capability": {
      "enum": [
        "chat",
        "reasoning",
        "code",
        "embedding",
        "image",
        "audio",
        "music",
        "sfx",
        "video",
        "streaming",
        "rerank",
        "tool"
      ]
    },
    "sourceEvidence": {
      "type": "object",
      "required": [
        "sourceUrl",
        "observedAt"
      ],
      "properties": {
        "sourceUrl": {
          "type": "string"
        },
        "observedAt": {
          "type": "string"
        }
      }
    },
    "clientApiCompatibilityEntry": {
      "type": "object",
      "required": [
        "clientApiCode",
        "displayName",
        "supportStatus",
        "protocolCodes",
        "apiCodes",
        "resourceCodes",
        "notes",
        "source"
      ],
      "properties": {
        "clientApiCode": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "displayName": {
          "type": "string"
        },
        "supportStatus": {
          "enum": [
            "supported",
            "unsupported",
            "partial"
          ]
        },
        "protocolCodes": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          }
        },
        "apiCodes": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.]*$"
          }
        },
        "resourceCodes": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.]*$"
          }
        },
        "notes": {
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/sourceEvidence"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
